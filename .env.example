# Nusxa ko'chirib .env nomi bilan saqlang va to'ldiring
PORT=3000
PUBLIC_URL=https://sizning-domeningiz.uz

# Birinchi ro'yxatdan o'tgan foydalanuvchi avtomatik admin bo'ladi. Qo'shimcha adminlar:
ADMIN_PHONES=+998901234567

# AI tarjima, rasmdagi matn (OCR) va video tarjimasi uchun (Claude)
ANTHROPIC_API_KEY=

# Videodagi nutqni matnga aylantirish uchun (OpenAI Whisper)
OPENAI_API_KEY=

# Firebase Phone Auth (bo'sh qoldirsangiz — test rejimi: kod ekranda ko'rinadi)
FIREBASE_PROJECT_ID=
FIREBASE_WEB_CONFIG={"apiKey":"...","authDomain":"...","projectId":"..."}

# Stripe (bo'sh qoldirsangiz — test rejimi: to'lovsiz yulduzcha beriladi; ishlab chiqarishda DEV_PAYMENTS=0 qiling)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DEV_PAYMENTS=1
DEV_OTP=1
